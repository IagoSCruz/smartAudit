# Desenvolvimento local — copie para .env; não use estes valores em produção.
DJANGO_SETTINGS_MODULE=smartaudit.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DOCUMENT_UPLOAD_MAX_BYTES=5242880

POSTGRES_DB=smartaudit
POSTGRES_USER=smartaudit
POSTGRES_PASSWORD=smartaudit-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=smartaudit
RABBITMQ_DEFAULT_PASS=smartaudit-local-only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://smartaudit:smartaudit-local-only@localhost:5672//

REDIS_PORT=6379
CELERY_RESULT_BACKEND=redis://localhost:6379/0

MINIO_ROOT_USER=smartaudit
MINIO_ROOT_PASSWORD=smartaudit-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
